{
  "name": "Quarto + R Environment",
  "image": "mcr.microsoft.com/devcontainers/r:latest",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/texlive:1": {},
    "ghcr.io/devcontainers/features/ghostscript:1": {}
  },
  "postCreateCommand": [
    "sudo apt-get update",
    "sudo apt-get install -y texlive-latex-recommended texlive-fonts-recommended texlive-latex-extra",
    "sudo apt-get install -y texlive-pictures texlive-luatex",
    "sudo apt-get install -y inkscape",
    "wget https://github.com/quarto-dev/quarto-cli/releases/download/v1.7.13/quarto-1.7.13-linux-amd64.deb",
    "sudo dpkg -i quarto-1.7.13-linux-amd64.deb",
    "quarto install tinytex",
    "Rscript -e \"install.packages('remotes', repos='http://cran.us.r-project.org')\"",
    "Rscript -e \"install.packages('knitr', repos='http://cran.us.r-project.org')\"",
    "Rscript -e \"install.packages('rmarkdown', repos='http://cran.us.r-project.org')\"",
    "Rscript install_packages.R"
  ],
  "forwardPorts": [8080]
}
